# Copy this file to ".env" and set strong, unique values before running
# `docker compose up`. The ".env" file is git-ignored and must never be
# committed. Do NOT reuse these placeholder values.

# Application database name (not a secret)
APP_DB_NAME=photoalbum

# Application database role (the user name is not a secret)
APP_USER=photoalbum

# Bootstrap administrator used only by the local PostgreSQL container.
# Keep this different from APP_USER; the application never uses this account.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Application database role password (required for the local PostgreSQL
# container only; on Azure the application authenticates password-lessly with a
# managed identity and no password exists)
APP_USER_PASSWORD=replace-with-a-strong-password

# Admin account used to authenticate photo upload/delete (state-changing endpoints).
# The user name is not a secret; the password is required and must be strong.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-a-strong-password
